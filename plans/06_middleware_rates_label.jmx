        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults (timeouts)" enabled="true">
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables"><collectionProp name="Arguments.arguments"/></elementProp>
  <stringProp name="HTTPSampler.connect_timeout">${__P(connect_timeout_ms,10000)}</stringProp>
  <stringProp name="HTTPSampler.response_timeout">${__P(response_timeout_ms,60000)}</stringProp>
</ConfigTestElement><hashTree/><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Users" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,60)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(loops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      <stringProp name="ThreadGroup.duration">${__P(duration,3600)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp></ThreadGroup>
      <hashTree>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time (think_time_ms + random up to think_time_range_ms)" enabled="true">
  <stringProp name="ConstantTimer.delay">${__P(think_time_ms,0)}</stringProp>
  <stringProp name="RandomTimer.range">${__P(think_time_range_ms,0)}</stringProp>
</UniformRandomTimer><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01 Get Rates" enabled="false">
          <stringProp name="HTTPSampler.domain">${__P(host_mw,localhost)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(scheme,https)}</stringProp>
          <stringProp name="HTTPSampler.path">${__P(path_mw_account_prefix)}/${account}${__P(path_mw_rates_suffix)}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#13;
    "shipment_cost": {&#13;
        "service_level_code": "${service}",&#13;
        "account_number": "${account}",&#13;
        "additional_service_code": [&#13;
            "SR"&#13;
        ],&#13;
        "ship_from": {&#13;
            "country": "Canada",&#13;
            "state_province": "ON", &#13;
            "fsa_code": "${selected_from_fsa}"&#13;
        },&#13;
        "ship_to": {&#13;
            "country": "Canada",&#13;
            "state_province": "ON",&#13;
            "fsa_code": "${selected_to_fsa}"&#13;
        },&#13;
        "insurance_provider": "Carrier",&#13;
        "packages": [&#13;
            {&#13;
                "dimension_details": {&#13;
                    "dimension_unit": "cms",&#13;
                    "dimensions": {&#13;
                        "length": 9,&#13;
                        "width": 1,&#13;
                        "height": 12&#13;
                    }&#13;
                },&#13;
                "weight_details": {&#13;
                    "weight_unit": "lbs",&#13;
                    "weight": 9&#13;
                },&#13;
                "insured_value": {&#13;
                    "amount": 100,&#13;
                    "currency": "CAD"&#13;
                }&#13;
            },&#13;
            {&#13;
                "dimension_details": {&#13;
                    "dimension_unit": "inch",&#13;
                    "dimensions": {&#13;
                        "length": 12,&#13;
                        "width": 9,&#13;
                        "height": 8&#13;
                    }&#13;
                },&#13;
                "weight_details": {&#13;
                    "weight_unit": "lb",&#13;
                    "weight": 13&#13;
                },&#13;
                "insured_value": {&#13;
                    "amount": 1000,&#13;
                    "currency": "CAD"&#13;
                }&#13;
            }&#13;
        ]&#13;
    }&#13;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        <stringProp name="HTTPSampler.port">${__P(port,0)}</stringProp></HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"/>
            <stringProp name="parameters"/>
            <stringProp name="script">// Picks the FSA pair that matches the service level.
// STD service uses the "standard" FSA list, everything else the SD/ND list.
// The STD service code comes from the property std_service_code.
def stdCode = props.getProperty("std_service_code", "STD")
def service = vars.get("service")
String fromFsa
String toFsa
if (service != null &amp;&amp; service.equalsIgnoreCase(stdCode)) {
    fromFsa = vars.get("from_std")
    toFsa   = vars.get("to_std")
} else {
    fromFsa = vars.get("from_sdnd")
    toFsa   = vars.get("to_sdnd")
}
vars.put("selected_from_fsa", fromFsa)
vars.put("selected_to_fsa", toFsa)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="02 Create Label">
